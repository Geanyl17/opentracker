<?xml version="1.0" encoding="utf-8"?>
<!-- Backups keep transactions and settings but never the pairing with the relay. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
